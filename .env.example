# =============================================================================
# .env para correr Celery (Worker + Beat) en Windows, en esta copia del
# backend. Copia este archivo a ".env" (sin ".example") en esta misma
# carpeta, junto a manage.py, y llena los valores reales.
# =============================================================================

# Debe ser EXACTAMENTE el mismo SECRET_KEY que usa el backend Linux
# (Django lo usa para firmar sesiones/tokens; si difiere, nada calza).
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos MySQL principal (remota, la misma que usa el backend Linux) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# --- Segunda base de datos "control_gestion" (remota) ---
DB_CONTROL_GESTION_NAME=
DB_CONTROL_GESTION_USER=
DB_CONTROL_GESTION_PASSWORD=
DB_CONTROL_GESTION_HOST=
DB_CONTROL_GESTION_PORT=3306

# --- Redis local (esta PC Windows corre su propio Redis, separado del de Linux) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- ZAFIRO: descarga y scripts ---
ZAFIRO_DOWNLOAD_DIR=C:\ZafiroDescargas

# Ruta absoluta al index.js dentro de esta copia (ver scripts\zafiro\README.md).
# corregir_heuristico.exe debe vivir en la MISMA carpeta que index.js.
ZAFIRO_SCRIPT_PATH=C:\ruta\a\eje_central_back_copia\scripts\zafiro\index.js

# --- Opcionales (solo si algún modelo/vista los requiere al importar) ---
EMAIL_USER=
EMAIL_PASSWORD=
FRONTEND_REPO_PATH=
GEMINI_API_KEY=
